---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, type Locale } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  altPath?: string;
  locale?: Locale;
  type?: 'website' | 'article' | 'profile';
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** URL d'image à précharger (LCP) */
  preloadImage?: { href: string; imagesrcset?: string; imagesizes?: string };
  /** Thème du header au chargement */
  theme?: 'light' | 'dark';
}

const { title, description, path, altPath, locale = 'fr', type, schema, noindex, preloadImage, theme = 'dark' } = Astro.props;
---

<!doctype html>
<html lang={locale === 'fr' ? 'fr' : 'en'} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={SITE.founder} />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-italic.woff2" as="font" type="font/woff2" crossorigin />
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage.href}
          imagesrcset={preloadImage.imagesrcset}
          imagesizes={preloadImage.imagesizes}
          fetchpriority="high"
        />
      )
    }
    <Seo {title} {description} {path} {altPath} {locale} {type} {schema} {noindex} />
  </head>
  <body>
    <a href="#main" class="skip-link">{locale === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a>
    <div id="top"></div>
    <Header {locale} {altPath} />
    <main id="main">
      <slot />
    </main>
    <Footer {locale} />
    <div class="grain" aria-hidden="true"></div>
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
