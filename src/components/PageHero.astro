---
/**
 * En-tête des pages intérieures : titre massif + texte + fil d'Ariane.
 */
interface Props {
  eyebrow: string;
  title: string;
  titleAccent?: string;
  text?: string;
  crumbs: { href: string; label: string }[];
  dark?: boolean;
}
const { eyebrow, title, titleAccent, text, crumbs, dark = true } = Astro.props;
---

<section class:list={['page-hero', dark && 'section--dark']}>
  <div class="container">
    <nav class="crumbs fade-up" aria-label="Fil d'Ariane">
      <ol>
        {
          crumbs.map((c, i) => (
            <li>
              {i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </li>
          ))
        }
      </ol>
    </nav>
    <p class="eyebrow fade-up" style="--delay:.05s">{eyebrow}</p>
    <h1 class="page-hero__title display">
      <span data-split>{title}</span>
      {titleAccent && <span class="accent" data-split>{titleAccent}</span>}
    </h1>
    {text && <p class="page-hero__text lead fade-up" style="--delay:.2s">{text}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    padding: clamp(8rem, 18vh, 12rem) 0 clamp(3rem, 8vh, 6rem);
    background: var(--bg);
    color: var(--fg);
  }
  .crumbs {
    margin-bottom: 2.5rem;
    font-size: var(--step--1);
    color: var(--fg-muted);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    opacity: 0.5;
  }
  .crumbs a:hover {
    color: var(--fg);
  }
  .page-hero__title {
    margin-top: 1.25rem;
    font-size: clamp(3rem, 1rem + 9vw, 10rem);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.25em;
  }
  .page-hero__title .accent {
    font-size: 0.92em;
  }
  .page-hero__text {
    margin-top: 2.5rem;
    max-width: 48ch;
    color: var(--fg-muted);
  }
</style>
